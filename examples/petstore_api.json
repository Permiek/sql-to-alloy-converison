{
  "openapi": "3.0.0",
  "info": {
    "title": "Petstore API",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Owner": {
        "type": "object",
        "required": ["id", "name", "email"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "Pet": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "species": {
            "type": "string",
            "enum": ["dog", "cat", "bird", "fish"]
          },
          "status": {
            "type": "string",
            "enum": ["available", "pending", "adopted"]
          },
          "age": {
            "type": "integer"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          }
        }
      },
      "Appointment": {
        "type": "object",
        "required": ["id", "pet", "date"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "pet": {
            "$ref": "#/components/schemas/Pet"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
